# 설치형 LLM (OpenAI 호환 엔드포인트: Ollama, vLLM, LM Studio, llama.cpp server 등)
AO_LLM_BASE_URL=http://localhost:11434/v1
AO_LLM_MODEL=qwen2.5-coder:14b
AO_LLM_API_KEY=local
AO_LLM_TIMEOUT=300
# false 로 두면 LLM 없이 규칙 기반 점수만 계산
AO_LLM_ENABLED=true

# 스캔/등록을 허용할 서버 경로 (여러 개면 리눅스는 ':' 로 구분). 비워두면 제한 없음
AO_ALLOWED_ROOTS=/mnt/share
AO_DATA_DIR=./data
# LLM 에 보여줄 코드 발췌 최대 글자 수 (모델 컨텍스트에 맞게 조정)
AO_MAX_CONTEXT_CHARS=16000
# 통합 후보로 묶을 유사도 기준 (0~1, 높을수록 엄격)
AO_SIMILARITY_THRESHOLD=0.3

# docker-compose 용: 평가할 공유폴더 경로
SHARE_DIR=/mnt/share
